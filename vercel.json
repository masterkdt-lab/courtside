{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.courtsidetravel.co"
        }
      ],
      "destination": "https://courtsidetravel.co/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/private-groups",
      "destination": "/api/lineup"
    },
    {
      "source": "/api/private-groups-reminders",
      "destination": "/api/lineup"
    }
  ],
  "crons": [
    {
      "path": "/api/private-groups-reminders",
      "schedule": "0 17 * * *"
    }
  ]
}
