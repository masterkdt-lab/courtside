# Which data layer to use: mock (local JSON file under .data/, the default) or sheets (the Google Sheet below).
DATA_BACKEND=mock
# ID of Katie's Google Sheet: the long string in its URL between /spreadsheets/d/ and /edit.
SHEET_ID=
# Service account email from Google Cloud Console > IAM & Admin > Service Accounts (ends in .iam.gserviceaccount.com); share the Sheet with it as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" value from that service account's JSON key file (Keys > Add key > JSON), pasted on one line inside double quotes with the literal \n sequences kept.
GOOGLE_PRIVATE_KEY=
# Random secret that signs the cs_session cookie (for example the output of: openssl rand -hex 32); has a dev default locally but must be set in Vercel.
COOKIE_SECRET=
# log (print every email to the console, the default for dev and tests) or resend (deliver through Resend).
EMAIL_MODE=log
# Resend API key from resend.com > API Keys; only used when EMAIL_MODE=resend.
EMAIL_API_KEY=
# Sender address on a domain verified in Resend, for example "Courtside Travel Co. <katie@yourdomain.com>".
FROM_EMAIL=
# Comma-separated addresses that receive every request notification (Katie, KC).
NOTIFY_EMAILS=
# Full browser URL of the Google Sheet, linked at the bottom of each notification email.
SHEET_URL=
